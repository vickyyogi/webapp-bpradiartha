  @@map("workflows")
}

model WorkflowStep {
  id             String   @id @default(uuid()) @db.Uuid
  workflowId     String   @map("workflow_id") @db.Uuid
  stepOrder      Int      @map("step_order")
  name           String   @db.VarChar(200)
  approverRoleId String?  @map("approver_role_id") @db.Uuid
  minAmount      Float    @default(0) @map("min_amount")
  maxAmount      Float?   @map("max_amount")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverRole Role?    @relation(fields: [approverRoleId], references: [id])

  @@unique([workflowId, stepOrder])
  @@map("workflow_steps")
}

model WorkflowInstance {
  id                String   @id @default(uuid()) @db.Uuid
  workflowId        String?  @map("workflow_id") @db.Uuid
  entityType        String   @map("entity_type") @db.VarChar(100) // e.g. PURCHASE_REQUEST
  entityId          String   @map("entity_id") @db.VarChar(100)
  currentStep       Int      @default(1) @map("current_step")
  status            String   @default("PENDING") @db.VarChar(50) // PENDING, APPROVED, REJECTED, RETURNED
  purchaseRequestId String?  @map("purchase_request_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workflow        Workflow?        @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  actions         WorkflowAction[]

  @@map("workflow_instances")
}

model WorkflowAction {
  id         String   @id @default(uuid()) @db.Uuid
  instanceId String   @map("instance_id") @db.Uuid
  stepNumber Int      @map("step_number")
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(50) // SUBMIT, APPROVE, REJECT, RETURN
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actor    User             @relation("WorkflowActionActor", fields: [actorId], references: [id])

  @@map("workflow_actions")
}

// ==========================================
// SECTION 22: AUDIT TRAIL ENGINE
// ==========================================

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(50) // CREATE, UPDATE, DELETE, APPROVE, REJECT, LOGIN, LOGOUT, UPLOAD, DOWNLOAD, STATUS_CHANGE, ASSIGN, TRANSFER, DISPOSAL
  entityType     String   @map("entity_type") @db.VarChar(100) // CREDIT_APPLICATION, LEAD, PURCHASE_REQUEST, PURCHASE_ORDER, INVENTORY_ITEM, ASSET, DOCUMENT, USER
  entityId       String   @map("entity_id") @db.VarChar(100)
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address") @db.VarChar(50)
  userAgent      String?  @map("user_agent") @db.Text
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

