  @@index([userId, isRead])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

// ==========================================
// SECTION 26: CENTRALIZED MASTER DATA
// ==========================================

model MasterItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  category       String   @db.VarChar(100) // LOAN_PRODUCT, POSITION, ASSET_CATEGORY, INVENTORY_CATEGORY, LEAD_SOURCE, VENDOR_CATEGORY, UNIT
  code           String   @db.VarChar(100)
  name           String   @db.VarChar(200)
  description    String?  @db.Text
  attributes     Json?
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, category, code])
  @@index([organizationId, category, isActive])
  @@map("master_items")
}



