// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branches             Branch[]
  departments          Department[]
  users                User[]
  leads                Lead[] // added for Lead relation
  customers            Customer[] // Tahap 2A (P0.2): master nasabah/debitur terpisah dari pegawai
  creditApplications   CreditApplication[]
  creditApprovalLimits CreditApprovalLimit[]
  fieldTasks           FieldTask[]
  documents            Document[]
  inventoryItems       InventoryItem[]
  assets               Asset[]
  vendors              Vendor[]
  purchaseRequests     PurchaseRequest[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  workflows            Workflow[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  cmsBanners           CmsBanner[]
  cmsPosts             CmsPost[]
  cmsFaqs              CmsFaq[]
  cmsGalleries         CmsGallery[]
  cmsProducts          CmsProduct[]
  cmsReports           CmsReport[]
  cmsHeroSlides        CmsHeroSlide[]
  masterItems          MasterItem[]
  slikAnalysisRecords  SlikAnalysisRecord[]
  creditSlikOverrides  CreditSlikOverride[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(50)
  name           String   @db.VarChar(200)
  address        String?  @db.Text
  phone          String?  @db.VarChar(50)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization       Organization        @relation(fields: [organizationId], references: [id])
  users              User[] // added backrelation for User.branch
  leads              Lead[] // existing leads relation
  customers          Customer[] // Tahap 2A (P0.2): nasabah dapat terikat ke cabang
  creditApplications CreditApplication[]
  slikAnalysisRecords SlikAnalysisRecord[]
  fieldTasks         FieldTask[]
  inventoryItems     InventoryItem[]
  assets             Asset[]
  purchaseRequests   PurchaseRequest[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]

  @@unique([organizationId, code])
  @@map("branches")
}

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(50)
  name           String   @db.VarChar(200)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization      @relation(fields: [organizationId], references: [id])
  users            User[]
  purchaseRequests PurchaseRequest[]

  @@unique([organizationId, code])
  @@map("departments")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  branchId            String?   @map("branch_id") @db.Uuid
  departmentId        String?   @map("department_id") @db.Uuid
  email               String    @unique @db.VarChar(255)
  passwordHash        String?   @map("password_hash") @db.Text
  fullName            String    @map("full_name") @db.VarChar(200)
  employeeNumber      String?   @map("employee_number") @db.VarChar(100)
  phone               String?   @db.VarChar(50)
  isActive            Boolean   @default(true) @map("is_active")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  // Tahap 1A — P0.1: penguncian akun & pencabutan sesi saat sandi berubah.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz
  // Tahap 1B — P0.1: autentikasi dua faktor (TOTP) untuk peran berisiko tinggi.
  // mfaSecret disimpan TERENKRIPSI (AES-256-GCM) melalui src/lib/mfa.ts.
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecret           String?   @map("mfa_secret")
  mfaEnrolledAt       DateTime? @map("mfa_enrolled_at") @db.Timestamptz
  mfaLastTimeStep     Int?      @map("mfa_last_time_step")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])

  leads Lead[] @relation("LeadOfficer") // reverse relation for assignedOfficer

  userRoles UserRole[] // backrelation for UserRole.user

  // Tahap 2A (P0.2): relasi master nasabah dibuat/diubah/diverifikasi oleh pegawai.
  createdCustomers  Customer[] @relation("CustomerCreatedBy")
  updatedCustomers  Customer[] @relation("CustomerUpdatedBy")
  verifiedCustomers Customer[] @relation("CustomerVerifiedBy")

  // Tahap 2B (P0.2): jejak riwayat identitas, hubungan, dan consent nasabah.
  customerHistoriesChanged     CustomerIdentityHistory[] @relation("CustomerHistoryChangedBy")
  customerHistoriesVerified    CustomerIdentityHistory[] @relation("CustomerHistoryVerifiedBy")
  customerRelationshipsCreated CustomerRelationship[]    @relation("CustomerRelationshipCreator")
  customerConsentsRecorded     CustomerConsent[]         @relation("CustomerConsentRecorder")

  marketingCreditApplications    CreditApplication[]    @relation("CreditMarketingOfficer")
  analystCreditApplications      CreditApplication[]    @relation("CreditAnalyst")
  surveyCreditApplications       CreditApplication[]    @relation("CreditSurveyOfficer")
  decisionCreditApplications     CreditApplication[]    @relation("CreditDecisionMaker")
  statusChanges                  CreditStatusHistory[]
  creditApprovals                CreditApprovalRecord[]
  assignedFieldTasks             FieldTask[]            @relation("OfficerFieldTasks")
  uploadedDocuments              Document[]             @relation("DocumentUploader")
  assignedAssets                 Asset[]                @relation("AssetCurrentHolder")
  performedInventoryTransactions InventoryTransaction[] @relation("InventoryTransactionPerformer")
  performedAssetHistories        AssetHistory[]         @relation("AssetHistoryPerformer")
  performedAssetMaintenances     AssetMaintenance[]     @relation("AssetMaintenancePerformer")
  requestedPurchaseRequests      PurchaseRequest[]      @relation("PurchaseRequester")
  createdPurchaseOrders          PurchaseOrder[]        @relation("PurchaseOrderCreator")
  receivedGoodsReceipts          GoodsReceipt[]         @relation("GoodsReceiptReceiver")
  performedWorkflowActions       WorkflowAction[]       @relation("WorkflowActionActor")
  createdSlikAnalyses            SlikAnalysisRecord[]    @relation("SlikAnalysisCreatedBy")
  recordedSlikOverrides          CreditSlikOverride[]    @relation("SlikOverrideRecorder")
  auditLogs                      AuditLog[]             @relation("AuditLogUser")
  notifications                  Notification[]         @relation("UserNotifications")
  mfaBackupCodes                 MfaBackupCode[]
  mfaChallenges                  MfaChallenge[]
  passwordResetTokens            PasswordResetToken[]
  mustChangePassword             Boolean                @default(false) @map("must_change_password")
  sessionsValidFrom              DateTime?              @map("sessions_valid_from") @db.Timestamptz

  @@map("users")
}

/// Kode cadangan MFA: disimpan sebagai hash satu arah, sekali pakai (Tahap 1B).
model MfaBackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(128)
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_backup_codes")
}

/// Tantangan langkah kedua saat login (Tahap 1B). Token yang dikirim ke klien
/// disimpan sebagai hash, berumur pendek, sekali pakai, dan membatasi percobaan.
model MfaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenges")
}

/// Tautan reset kata sandi (Tahap 1B-2). Yang disimpan hanya hash token,
/// berumur pendek (30 menit), sekali pakai, dan membatasi percobaan.
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  attempts    Int       @default(0)
  requestedIp String?   @map("requested_ip") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users                UserRole[]
  permissions          RolePermission[]
  creditApprovalLimits CreditApprovalLimit[]
  workflowSteps        WorkflowStep[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(150)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  APPLICATION
  CONVERTED
}

model Lead {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  branchId          String?    @map("branch_id") @db.Uuid
  source            String     @db.VarChar(100)
  name              String     @db.VarChar(200)
  phone             String?    @db.VarChar(50)
  address           String?    @db.Text
  productInterest   String?    @db.VarChar(200)
  status            LeadStatus @default(NEW)
  assignedOfficerId String?    @map("assigned_officer_id") @db.Uuid
  notes             String?    @db.Text
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization @relation(fields: [organizationId], references: [id])
  branch          Branch?      @relation(fields: [branchId], references: [id])
  assignedOfficer User?        @relation("LeadOfficer", fields: [assignedOfficerId], references: [id])
  fieldTasks      FieldTask[]

  @@map("leads")
}

// ==========================================
// SECTION 2A (Tahap 2 — P0.2): MASTER NASABAH / DEBITUR
// Entitas ini TERPISAH dari User/Pegawai. Pengajuan kredit merujuk ke Customer,
// bukan ke akun pegawai. Identitas disimpan terstruktur, bukan di catatan bebas.
// ==========================================

enum CustomerType {
  INDIVIDU
  BADAN
}

enum CustomerStatus {
  PROSPEK
  AKTIF
  NONAKTIF
  BLACKLIST
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  branchId       String?        @map("branch_id") @db.Uuid
  customerNumber String         @map("customer_number") @db.VarChar(50)
  customerType   CustomerType   @default(INDIVIDU) @map("customer_type")
  status         CustomerStatus @default(PROSPEK)
  legalName      String         @map("legal_name") @db.VarChar(200)
  nickname       String?        @db.VarChar(100)

  // Identitas (terstruktur). Untuk INDIVIDU: NIK (KTP). Untuk BADAN: nomor ID usaha/NIB.
  identityType   String?   @map("identity_type") @db.VarChar(50) // KTP, SIM, PASPOR, NIB, NPWP
  identityNumber String?   @map("identity_number") @db.VarChar(64) // NIK 16 digit / ID usaha
  npwp           String?   @db.VarChar(40)
  birthPlace     String?   @map("birth_place") @db.VarChar(150)
  birthDate      DateTime? @map("birth_date") @db.Timestamptz // tanggal lahir (INDIVIDU) / tanggal berdiri (BADAN)
  gender         String?   @db.VarChar(20)

  // Alamat terstruktur
  address    String? @db.Text
  rtRw       String? @map("rt_rw") @db.VarChar(20)
  kelurahan  String? @db.VarChar(100)
  kecamatan  String? @db.VarChar(100)
  city       String? @db.VarChar(100)
  province   String? @db.VarChar(100)
  postalCode String? @map("postal_code") @db.VarChar(10)

  // Kontak
  phone String? @db.VarChar(50)
  email String? @db.VarChar(255)

  // Profil usaha/pekerjaan (opsional)
  occupation    String? @db.VarChar(150)
  employerName  String? @map("employer_name") @db.VarChar(200)
  monthlyIncome Float?  @map("monthly_income") // nominal belum dimigrasikan ke Decimal pada tahap ini (P0.6 = Tahap 6)

  // Jejak perubahan & verifikasi identitas (P0.2)
  createdById  String?   @map("created_by_id") @db.Uuid
  updatedById  String?   @map("updated_by_id") @db.Uuid
  verifiedById String?   @map("verified_by_id") @db.Uuid
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz

  // Jejak konversi data lama (Tahap 2A): id baris users yang dahulu dipakai sebagai pemohon.
  // Kolom ini HANYA untuk penelusuran migrasi dan TIDAK memberi hak login apa pun.
  legacyApplicantUserId String? @map("legacy_applicant_user_id") @db.Uuid

  isActive  Boolean  @default(true) @map("is_active")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  createdBy    User?        @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?        @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  verifiedBy   User?        @relation("CustomerVerifiedBy", fields: [verifiedById], references: [id])

  creditApplications CreditApplication[]

  // Tahap 5A (P0.5): hasil analisa SLIK yang tersimpan untuk nasabah ini.
  slikAnalyses SlikAnalysisRecord[]

  // Tahap 2B (P0.2): riwayat identitas, hubungan antar-pihak, dan persetujuan data pribadi.
  identityHistories      CustomerIdentityHistory[]
  relationshipsAsSubject CustomerRelationship[]    @relation("CustomerRelationshipSubject")
  relationshipsAsRelated CustomerRelationship[]    @relation("CustomerRelationshipRelated")
  consents               CustomerConsent[]

  @@unique([organizationId, customerNumber])
  @@index([organizationId, identityNumber])
  @@index([organizationId, legalName])
  @@map("customers")
}

/// Riwayat perubahan identitas nasabah (Tahap 2B — P0.2).
/// Mencatat siapa mengubah, kapan, field apa, nilai lama/baru, dan verifikator.
model CustomerIdentityHistory {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  changedById   String?  @map("changed_by_id") @db.Uuid
  verifiedById  String?  @map("verified_by_id") @db.Uuid
  action        String   @db.VarChar(50) // CREATE, UPDATE, VERIFY
  changedFields Json?    @map("changed_fields") // daftar nama field identitas yang berubah
  oldValues     Json?    @map("old_values")
  newValues     Json?    @map("new_values")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  changedBy  User?    @relation("CustomerHistoryChangedBy", fields: [changedById], references: [id])
  verifiedBy User?    @relation("CustomerHistoryVerifiedBy", fields: [verifiedById], references: [id])

  @@index([customerId, createdAt])
  @@map("customer_identity_histories")
}

enum CustomerRelationshipType {
  SPOUSE
  GUARANTOR
  UBO
  FAMILY
  BUSINESS_PARTNER
  OTHER
}

/// Hubungan antar-pihak (Tahap 2B — P0.2): pasangan, penjamin, UBO, dsb.
/// Pihak terkait dapat berupa nasabah lain (relatedCustomerId) atau nama/identitas lepas.
model CustomerRelationship {
  id                    String                   @id @default(uuid()) @db.Uuid
  customerId            String                   @map("customer_id") @db.Uuid
  relatedCustomerId     String?                  @map("related_customer_id") @db.Uuid
  relationshipType      CustomerRelationshipType @map("relationship_type")
  relatedName           String?                  @map("related_name") @db.VarChar(200)
  relatedIdentityNumber String?                  @map("related_identity_number") @db.VarChar(64)
  notes                 String?                  @db.Text
  createdById           String?                  @map("created_by_id") @db.Uuid
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  customer        Customer  @relation("CustomerRelationshipSubject", fields: [customerId], references: [id], onDelete: Cascade)
  relatedCustomer Customer? @relation("CustomerRelationshipRelated", fields: [relatedCustomerId], references: [id])
  createdBy       User?     @relation("CustomerRelationshipCreator", fields: [createdById], references: [id])

  @@index([customerId])
  @@index([relatedCustomerId])
  @@map("customer_relationships")
}

enum CustomerConsentType {
  DATA_PROCESSING
  DATA_SHARING
  MARKETING
  CREDIT_CHECK
}

/// Bukti persetujuan pemrosesan data pribadi (Tahap 2B — P0.2).
/// Bersifat catatan (append-only secara operasional): pemberian dan pencabutan direkam.
model CustomerConsent {
  id            String              @id @default(uuid()) @db.Uuid
  customerId    String              @map("customer_id") @db.Uuid
  consentType   CustomerConsentType @map("consent_type")
  granted       Boolean             @default(true)
  policyVersion String?             @map("policy_version") @db.VarChar(50)
  evidenceRef   String?             @map("evidence_ref") @db.VarChar(255)
  grantedAt     DateTime?           @map("granted_at") @db.Timestamptz
  revokedAt     DateTime?           @map("revoked_at") @db.Timestamptz
  recordedById  String?             @map("recorded_by_id") @db.Uuid
  notes         String?             @db.Text
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation("CustomerConsentRecorder", fields: [recordedById], references: [id])

  @@index([customerId, consentType])
  @@map("customer_consents")
}

enum CreditApplicationStatus {
  DRAFT
  SUBMITTED
  VERIFICATION
  ANALYSIS
  SURVEY
  REVIEW
  DECISION
  APPROVED
  REJECTED
  RETURNED
}

model CreditApplication {
  id                         String                  @id @default(uuid()) @db.Uuid
  organizationId             String                  @map("organization_id") @db.Uuid
  branchId                   String?                 @map("branch_id") @db.Uuid
  applicationNumber          String                  @unique @db.VarChar(50)
  customerId                 String                  @map("customer_id") @db.Uuid
  product                    String?                 @db.VarChar(200)
  requestedAmount            Float?
  requestedTenorMonths       Int?
  purpose                    String?                 @db.Text
  source                     String?                 @db.VarChar(100)
  assignedMarketingOfficerId String?                 @map("assigned_marketing_officer_id") @db.Uuid
  assignedAnalystId          String?                 @map("assigned_analyst_id") @db.Uuid
  assignedSurveyOfficerId    String?                 @map("assigned_survey_officer_id") @db.Uuid
  status                     CreditApplicationStatus @default(DRAFT)
  submissionDate             DateTime?               @map("submission_date") @db.Timestamptz
  notes                      String?                 @db.Text

  // Analisis 5C, Scoring & Survey Data (Configurable JSON)
  analysisData Json? @map("analysis_data")
  surveyData   Json? @map("survey_data")

  // Keputusan Komite Kredit
  approvedAmount      Float?    @map("approved_amount")
  approvedTenorMonths Int?      @map("approved_tenor_months")
  interestRate        Float?    @map("interest_rate")
  decisionDate        DateTime? @map("decision_date") @db.Timestamptz
  decisionMakerId     String?   @map("decision_maker_id") @db.Uuid
  decisionNotes       String?   @map("decision_notes") @db.Text
  conditions          String?   @db.Text

  // Realisasi / Pencairan Kredit
  realizationDate      DateTime? @map("realization_date") @db.Timestamptz
  realizationReference String?   @map("realization_reference") @db.VarChar(100)
  realizationAmount    Float?    @map("realization_amount")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization @relation(fields: [organizationId], references: [id])
  branch           Branch?      @relation(fields: [branchId], references: [id])
  customer         Customer     @relation(fields: [customerId], references: [id])
  marketingOfficer User?        @relation("CreditMarketingOfficer", fields: [assignedMarketingOfficerId], references: [id])
  analyst          User?        @relation("CreditAnalyst", fields: [assignedAnalystId], references: [id])
  surveyOfficer    User?        @relation("CreditSurveyOfficer", fields: [assignedSurveyOfficerId], references: [id])
  decisionMaker    User?        @relation("CreditDecisionMaker", fields: [decisionMakerId], references: [id])

  statusHistories CreditStatusHistory[]
  approvalRecords CreditApprovalRecord[]
  fieldTasks      FieldTask[]
  slikAnalyses    SlikAnalysisRecord[]
  slikOverrides   CreditSlikOverride[]

  @@map("credit_applications")
}

/// Hasil analisa SLIK OJK (IDEB) yang tersimpan (Tahap 5A — P0.5).
/// Setiap hasil analisa WAJIB terkait nasabah terdaftar (dari pengajuan kredit),
/// sehingga hasil analisa tidak pernah menjadi data liar yang hilang saat
/// pengguna memasukkan analisa baru.
/// Nominal uang sengaja TIDAK dijadikan kolom tersendiri — nilai uang tetap di
/// dalam `result` (JSON) dan akan ikut dimigrasikan bersama P0.6 (Tahap 6).
model SlikAnalysisRecord {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  branchId            String?  @map("branch_id") @db.Uuid
  customerId          String   @map("customer_id") @db.Uuid
  creditApplicationId String?  @map("credit_application_id") @db.Uuid

  // Snapshot ringkas untuk daftar/riwayat (tetap terbaca bila data induk berubah).
  customerName    String @map("customer_name") @db.VarChar(200)
  sourceFileNames Json?  @map("source_file_names") // daftar nama berkas PDF sumber
  mode            String @db.VarChar(20) // "per-file" | "merge"

  // Ringkasan hasil AI untuk daftar/penyaringan. `rekomendasi` adalah
  // REKOMENDASI AI (alat bantu analisis), BUKAN keputusan kredit.
  rekomendasi String  @db.VarChar(20) // REJECT | APPROVE | CONSIDER
  riskRating  String? @map("risk_rating") @db.VarChar(40)
  modelUsed   String? @map("model_used") @db.VarChar(100)
  elapsedMs   Int?    @map("elapsed_ms")

  // Hasil lengkap ternormalisasi (SlikAnalysis) + metadata (warnings, sources).
  result Json
  meta   Json?

  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization       @relation(fields: [organizationId], references: [id])
  branch            Branch?            @relation(fields: [branchId], references: [id])
  customer          Customer           @relation(fields: [customerId], references: [id])
  creditApplication CreditApplication? @relation(fields: [creditApplicationId], references: [id])
  createdBy         User?              @relation("SlikAnalysisCreatedBy", fields: [createdById], references: [id])

  overrides CreditSlikOverride[]

  @@index([organizationId, createdAt])
  @@index([organizationId, customerId])
  @@map("slik_analysis_records")
}

/// Alasan penerusan pengajuan meski rekomendasi AI = REJECT (Tahap 5B — P0.5).
/// Wajib diisi oleh Account Officer atau petugas survei lapangan sebelum
/// pengajuan dapat dilanjutkan. Satu alasan menanggapi satu analisa — bila
/// muncul analisa REJECT yang lebih baru, alasan baru diperlukan kembali.
model CreditSlikOverride {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  creditApplicationId  String   @map("credit_application_id") @db.Uuid
  slikAnalysisRecordId String?  @map("slik_analysis_record_id") @db.Uuid
  rekomendasi          String   @db.VarChar(20) // rekomendasi AI yang ditanggapi (REJECT)
  reason               String   @db.Text
  recordedById         String?  @map("recorded_by_id") @db.Uuid
  recordedByName       String   @map("recorded_by_name") @db.VarChar(200)
  recordedByRole       String   @map("recorded_by_role") @db.VarChar(40) // AO | SURVEY
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization       Organization        @relation(fields: [organizationId], references: [id])
  creditApplication  CreditApplication   @relation(fields: [creditApplicationId], references: [id])
  slikAnalysisRecord SlikAnalysisRecord? @relation(fields: [slikAnalysisRecordId], references: [id])
  recordedBy         User?               @relation("SlikOverrideRecorder", fields: [recordedById], references: [id])

  @@index([creditApplicationId, createdAt])
  @@map("credit_slik_overrides")
}

model CreditStatusHistory {
  id                  String                  @id @default(uuid()) @db.Uuid
  creditApplicationId String                  @map("credit_application_id") @db.Uuid
  status              CreditApplicationStatus
  notes               String?                 @db.Text
  changedById         String?                 @map("changed_by_id") @db.Uuid
